{
  "name": "firmware-bench",
  "private": true,
  "type": "module",
  "description": "The bench: flash an ESP32 on the operator's desk from a KubeCoder environment, and read its serial log.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.page.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . && npm run typecheck",
    "dev": "node src/server/main.ts",
    "start": "node dist/node/server/main.js"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/w3c-web-serial": "1.0.9",
    "@types/ws": "8.18.2",
    "eslint": "10.15.0",
    "esptool-js": "0.7.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
